{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Full-Stack Dev Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "server.ts"],
      "console": "integratedTerminal",
      "restart": true,
      "env": {
        "NODE_ENV": "development",
        "PORT": "3000"
      },
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Run Automated Tests",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "tests/voice_agent.test.ts"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
