# ==============================================================================
# NMIMS AI Admission Voice Assistant - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
WEBHOOK_BASE_URL=http://localhost:3000

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Telephony Configuration (Provider: twilio | exotel | plivo)
TELEPHONY_PROVIDER=twilio

# Twilio Credentials (Required if TELEPHONY_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Exotel Credentials (Required if TELEPHONY_PROVIDER=exotel)
EXOTEL_ACCOUNT_SID=your_exotel_sid_here
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_CALLER_ID=0XXXXXXXXXX
EXOTEL_APP_ID=your_exotel_app_id_here

# Plivo Credentials (Required if TELEPHONY_PROVIDER=plivo)
PLIVO_AUTH_ID=your_plivo_auth_id_here
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here
PLIVO_PHONE_NUMBER=+91XXXXXXXXXX

# Human Admission Counsellor Transfer Configuration
COUNSELLOR_PHONE_NUMBER=+919876543210
COUNSELLOR_NAME=NMIMS Dhule Admission Cell

# Calling Hours Configuration (Timezone: Asia/Kolkata)
CALLING_HOURS_START=09:00
CALLING_HOURS_END=19:00
CALLING_TIMEZONE=Asia/Kolkata

# Database Configuration (Optional PostgreSQL URL; uses persistent JSON/in-memory store fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nmims_admission

# Security
JWT_SECRET=super_secret_jwt_key_nmims_2026
ADMIN_PASSWORD=admin@nmims2026
